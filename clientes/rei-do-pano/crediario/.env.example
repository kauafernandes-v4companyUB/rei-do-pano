# Frontend (públicas). Na Vercel vêm da integração Supabase com prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key pública>

# Edge Functions (secrets do Supabase, nunca no frontend):
#   supabase secrets set ADMIN_EMAILS=email1@dominio.com,email2@dominio.com
#   supabase secrets set ALLOWED_ORIGINS=https://crediario.reidopano.com.br
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY já são injetadas pelo runtime.
